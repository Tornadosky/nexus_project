{
  "environment": "Go1JoystickFlatTerrain",
  "observation_schema": "base_height (m), roll (rad), pitch (rad), lin_vel_x, lin_vel_y, yaw_rate, command_x, command_y, command_yaw (commanded velocities)",
  "meta_policy_notes": "The high-level controller selects among these skills based on the current state and commanded velocities. Activation rules are designed to be permissive and overlapping, allowing the meta-policy to choose the most appropriate skill when multiple are available. Reward terms prioritize the primary goal of the skill (e.g., matching velocity, standing up) while including secondary stabilizers and a small action penalty.",
  "skills": [
    {
      "name": "maintain_posture",
      "description": "Maintain a stable, upright standing posture when no significant movement commands are given, or when the robot is generally stable.",
      "activation_rule": "(abs(command_x) < 0.1 AND abs(command_y) < 0.1 AND abs(command_yaw) < 0.2) OR (base_height > 0.25 AND abs(roll) < 0.4 AND abs(pitch) < 0.4)",
      "reward_terms": [
        {
          "type": "target_height",
          "weight": 5.0,
          "lhs": "base_height",
          "rhs": null,
          "threshold": 0.3,
          "description": "Reward for maintaining base height around 0.3m."
        },
        {
          "type": "negative_distance",
          "weight": 2.0,
          "lhs": "abs(roll)",
          "rhs": null,
          "threshold": 0.0,
          "description": "Penalize large roll angles."
        },
        {
          "type": "negative_distance",
          "weight": 2.0,
          "lhs": "abs(pitch)",
          "rhs": null,
          "threshold": 0.0,
          "description": "Penalize large pitch angles."
        },
        {
          "type": "negative_distance",
          "weight": 1.0,
          "lhs": "abs(lin_vel_x)",
          "rhs": null,
          "threshold": 0.0,
          "description": "Penalize unwanted forward/backward movement."
        },
        {
          "type": "negative_distance",
          "weight": 1.0,
          "lhs": "abs(lin_vel_y)",
          "rhs": null,
          "threshold": 0.0,
          "description": "Penalize unwanted sideways movement."
        },
        {
          "type": "negative_distance",
          "weight": 1.0,
          "lhs": "abs(yaw_rate)",
          "rhs": null,
          "threshold": 0.0,
          "description": "Penalize unwanted yaw rotation."
        },
        {
          "type": "action_penalty",
          "weight": 0.01,
          "lhs": null,
          "rhs": null,
          "threshold": null,
          "description": "Small penalty for taking actions."
        }
      ]
    },
    {
